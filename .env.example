# Copy to .env and fill in. Never commit .env.
# Every setting in ingestion/config.py is listed; commented-out lines show the default.

# --- Embeddings (Nebius AI Studio / Token Factory, OpenAI-compatible API) ---
EMBEDDING_PROVIDER=nebius            # nebius | fake (fake = offline hash vectors, tests/smoke only)
NEBIUS_API_KEY=
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_MAX_RETRIES=6
# FAKE_EMBEDDING_DIM=384
# SPARSE_MODEL=Qdrant/bm25           # the Docker image bakes Qdrant/bm25 (build arg SPARSE_MODEL)
# FASTEMBED_CACHE_DIR=               # FastEmbed default; /opt/fastembed in Docker

# --- Dataset (Kaggle). Credentials optional: the public dataset also downloads anonymously ---
KAGGLE_USERNAME=
KAGGLE_KEY=
# KAGGLE_DATASET=dylanjcastillo/7k-books-with-metadata
# KAGGLE_FILE=books.csv
# KAGGLE_DOWNLOAD_URL=https://www.kaggle.com/api/v1/datasets/download/{dataset}
# DOWNLOAD_TIMEOUT=120
# DATA_DIR=data                      # /app/data in Docker
# BOOKS_CSV=tests/fixtures/books_sample.csv   # use a local CSV instead of downloading

# --- Qdrant ---
QDRANT_URL=http://localhost:6333     # docker compose overrides this to http://qdrant:6333
QDRANT_COLLECTION=books
# QDRANT_API_KEY=
# QDRANT_TIMEOUT=60
# QDRANT_WAIT_SECONDS=60
# SNAPSHOT_DIR=snapshots             # /app/snapshots in Docker

# --- docker compose host ports ---
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334
